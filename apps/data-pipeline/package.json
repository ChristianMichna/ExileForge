{
  "name": "@exileforge/data-pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Builds versioned game-data snapshots from the pinned Path of Building (PoE2) release and diffs them against the previous version (F-01).",
  "bin": {
    "exileforge-data": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cli": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@exileforge/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
