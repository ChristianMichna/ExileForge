{
  "name": "@exileforge/calc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Calc service: a pool of long-lived headless Path of Building (PoE2) LuaJIT workers behind the calc RPC contract (F-04).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "exileforge-calc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "lua"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cli": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@exileforge/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
