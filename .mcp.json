{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/playwright-mcp.mjs"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    }
  }
}
