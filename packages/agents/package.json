{
  "name": "@astrolabe/agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pipeline stages of Astrolabe as small checked tasks with their own response schema (prompts, task specs, stage planning). Runs under apps/server (forge loop) and later under the BYOK gateway.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrolabe/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
