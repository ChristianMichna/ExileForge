{
  "name": "@exileforge/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ExileForge design system: tokens, fonts, ornaments and React components in a custom dark-fantasy style.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@exileforge/contracts": "workspace:*",
    "@fontsource/alegreya-sans": "5.2.5",
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/marcellus-sc": "5.2.5",
    "pixi.js": "8.22.0"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
