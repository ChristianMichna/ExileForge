{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "from": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "to": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "baseItem",
          "mod",
          "uniqueItem",
          "gem",
          "passiveNode",
          "characterClass",
          "ascendancy",
          "craftingAction",
          "statTranslation"
        ],
        "description": "Kind of catalog entity (ExileForge's own grouping, not a game concept)"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "added": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "format": "starts_with",
                        "pattern": "^\\/.*"
                      },
                      "before": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "after": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "fields"
              ]
            }
          }
        },
        "required": [
          "added",
          "removed",
          "changed"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "from",
    "to",
    "kinds"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
