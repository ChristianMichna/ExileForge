        "dataReleaseId": {
          "type": "string",
          "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
          "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
        },
        "kind": {
          "type": "string",
          "const": "baseItem"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Base item type id – internal game id from the data release"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Display name in the release's default language"
              },
              "itemClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Classification id defined by the data release (not a fixed enum)"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Classification id defined by the data release (not a fixed enum)"
                }
              },
              "requirements": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "attributes": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "description": "Classification id defined by the data release (not a fixed enum)"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              },
              "implicitModIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Mod id – internal game id from the data release"
                }
              },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ]
                    }
                  ]
                }
              },
              "socketCapacity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dropLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "icon": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$",
                "description": "Path relative to the data release root"
              }
            },
            "required": [
              "id",
              "name",
              "itemClass",
              "tags",
              "requirements",
              "implicitModIds",
              "properties"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "dataReleaseId",
        "kind",
        "entities"
      ]
    },
