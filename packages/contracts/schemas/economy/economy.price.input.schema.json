{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "league": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "items": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "baseItem"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Base item type id – internal game id from the data release"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "uniqueItem"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Unique item id – internal game id from the data release"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          }
        ]
      }
    },
    "inCurrencyItemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Base item type id – internal game id from the data release"
    }
  },
  "required": [
    "items"
  ]
}
