{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "skillIdea": {
      "type": "string",
      "maxLength": 2000
    },
    "mainSkillId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Gem id – internal game id from the data release"
    },
    "mode": {
      "type": "object",
      "properties": {
        "hardcore": {
          "type": "boolean"
        },
        "ssf": {
          "type": "boolean"
        }
      },
      "required": [
        "hardcore",
        "ssf"
      ]
    },
    "league": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "leveling": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "endgame": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "leveling",
        "endgame"
      ]
    },
    "preferences": {
      "type": "object",
      "properties": {
        "playstyleTags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Classification id defined by the data release (not a fixed enum)"
          }
        },
        "focus": {
          "type": "string",
          "enum": [
            "mapping",
            "bossing",
            "allround"
          ]
        },
        "pace": {
          "type": "string",
          "enum": [
            "tanky",
            "balanced",
            "fast"
          ]
        },
        "complexityTolerance": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "defenceLayers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Classification id defined by the data release (not a fixed enum)"
          }
        }
      },
      "required": [
        "focus",
        "pace",
        "complexityTolerance"
      ]
    },
    "exclusions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "baseItem",
              "mod",
              "uniqueItem",
              "gem",
              "passiveNode",
              "characterClass",
              "ascendancy",
              "craftingAction",
              "statTranslation"
            ],
            "description": "Kind of catalog entity (ExileForge's own grouping, not a game concept)"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "kind",
          "id"
        ]
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "dataReleaseId",
    "skillIdea",
    "mode",
    "budget",
    "preferences"
  ]
}
