{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "calcId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Id of a single PoB calculation"
    },
    "pobVersion": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Path of Building PoE2 release tag"
    },
    "dataReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "calcProfile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Calc profile id from config/calc-profiles/"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 as lowercase hex"
    },
    "computedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    },
    "mainSkill": {
      "type": "string",
      "minLength": 1
    },
    "stats": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsupportedMods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "calcId",
    "pobVersion",
    "dataReleaseId",
    "calcProfile",
    "inputHash",
    "computedAt",
    "stats",
    "warnings",
    "unsupportedMods"
  ]
}
