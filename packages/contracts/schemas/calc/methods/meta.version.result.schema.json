{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pobVersion": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Path of Building PoE2 release tag"
    },
    "gameVersion": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+){1,3}$",
      "description": "Game version as reported by the data source"
    },
    "dataReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    }
  },
  "required": [
    "protocolVersion",
    "pobVersion",
    "gameVersion",
    "dataReleaseId"
  ]
}
