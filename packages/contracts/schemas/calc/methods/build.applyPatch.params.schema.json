{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ops": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "setLevel"
              },
              "level": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "op",
              "level"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "setClass"
              },
              "classId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Character class id – internal game id from the data release"
              }
            },
            "required": [
              "op",
              "classId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "setAscendancy"
              },
              "ascendancyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Ascendancy id – internal game id from the data release"
              }
            },
            "required": [
              "op",
              "ascendancyId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "allocateNodes"
              },
              "nodeIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Passive skill id – internal game id from the data release"
                }
              },
              "weaponSet": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "op",
              "nodeIds"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "deallocateNodes"
              },
              "nodeIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Passive skill id – internal game id from the data release"
                }
              }
            },
            "required": [
              "op",
              "nodeIds"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "setSkill"
              },
              "groupKey": {
                "type": "string",
                "minLength": 1
              },
              "gemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Gem id – internal game id from the data release"
              },
              "level": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "quality": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "supports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "gemId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "description": "Gem id – internal game id from the data release"
                    },
                    "level": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "quality": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "gemId",
                    "level",
                    "quality"
                  ]
                }
              },
              "weaponSet": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "op",
              "groupKey",
              "gemId",
              "level",
              "quality",
              "supports"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "removeSkill"
              },
              "groupKey": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "groupKey"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "setItem"
              },
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "itemText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "op",
              "slot",
              "itemText"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "removeItem"
              },
              "slot": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "slot"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "setConfig"
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "boolean",
                  "number",
                  "string"
                ]
              }
            },
            "required": [
              "op",
              "key",
              "value"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "handle",
    "ops"
  ]
}
