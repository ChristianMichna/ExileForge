{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "planning",
        "waiting_user",
        "paused",
        "done",
        "failed"
      ]
    },
    "currentTask": {
      "type": "string",
      "pattern": "^S(?:[0-9]|1[01])(?:\\.[a-z][a-z0-9-]*)?$"
    },
    "completedTasks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plannedTasks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "runId",
    "phase",
    "completedTasks"
  ]
}
