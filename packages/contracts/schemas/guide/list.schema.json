{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "guides": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "guideId": {
                "type": "string",
                "minLength": 1
              },
              "dataReleaseId": {
                "type": "string",
                "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
                "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp"
              },
              "ascendancyId": {
                "type": "string",
                "minLength": 1
              },
              "ascendancyName": {
                "type": "string",
                "minLength": 1
              },
              "mainSkillId": {
                "type": "string",
                "minLength": 1
              },
              "mainSkillName": {
                "type": "string",
                "minLength": 1
              },
              "current": {
                "type": "boolean"
              }
            },
            "required": [
              "guideId",
              "dataReleaseId",
              "generatedAt",
              "ascendancyId",
              "mainSkillId",
              "current"
            ]
          },
          {
            "type": "object",
            "properties": {
              "guideId": {
                "type": "string",
                "minLength": 1
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "guideId",
              "error"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "guides"
  ]
}
