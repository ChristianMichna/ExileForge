{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "passiveNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Passive skill id – internal game id from the data release"
          },
          "pobNodeId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "gameId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name in the release's default language"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Classification id defined by the data release (not a fixed enum)"
          },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Stat id – internal game id from the data release"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "unresolved": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "unmatched",
                    "ambiguous",
                    "lossy",
                    "hidden"
                  ]
                }
              },
              "required": [
                "text",
                "reason"
              ]
            }
          },
          "position": {
            "type": "object",
            "properties": {
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "orbit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "orbitIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "point": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            },
            "required": [
              "groupId",
              "orbit",
              "orbitIndex"
            ]
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Passive skill id – internal game id from the data release"
            }
          },
          "arcs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Passive skill id – internal game id from the data release"
                },
                "center": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "to",
                "center",
                "radius"
              ]
            }
          },
          "classStartFor": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Character class id – internal game id from the data release"
            }
          },
          "ascendancyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Ascendancy id – internal game id from the data release"
          },
          "unlockedBy": {
            "type": "object",
            "properties": {
              "ascendancyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Ascendancy id – internal game id from the data release"
              },
              "nodeIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Passive skill id – internal game id from the data release"
                }
              }
            },
            "required": [
              "nodeIds"
            ]
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$",
            "description": "Path relative to the data release root"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "stats",
          "position",
          "connections"
        ]
      }
    },
    "passiveGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "center": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "orbitRadii": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "required": [
          "id",
          "center",
          "orbitRadii"
        ]
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "dataReleaseId",
    "passiveNodes",
    "passiveGroups",
    "skipped"
  ]
}
