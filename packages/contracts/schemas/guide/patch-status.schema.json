{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "guideId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "guideRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fromReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "toReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "chain": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
        "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
      }
    },
    "factChanges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pobVersion",
          "maxCharacterLevel",
          "passivePoints",
          "itemSlots",
          "rarities",
          "classifications"
        ]
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 timestamp"
    },
    "checkedReferences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verdict": {
      "type": "string",
      "enum": [
        "unaffected",
        "needs-recalc",
        "broken"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "baseItem",
                  "mod",
                  "uniqueItem",
                  "gem",
                  "passiveNode",
                  "passiveGroup",
                  "characterClass",
                  "ascendancy",
                  "craftingAction",
                  "statTranslation"
                ],
                "description": "Kind of catalog entity (Astrolabe's own grouping, not a game concept)"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "removed",
              "changed"
            ]
          },
          "locations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "starts_with",
              "pattern": "^\\/.*"
            }
          },
          "stageIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                },
                "before": {
                  "$ref": "#/$defs/__schema0"
                },
                "after": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "baseItem",
                    "mod",
                    "uniqueItem",
                    "gem",
                    "passiveNode",
                    "passiveGroup",
                    "characterClass",
                    "ascendancy",
                    "craftingAction",
                    "statTranslation"
                  ],
                  "description": "Kind of catalog entity (Astrolabe's own grouping, not a game concept)"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "id"
              ]
            }
          }
        },
        "required": [
          "ref",
          "impact",
          "locations"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "guideId",
    "guideRevision",
    "fromReleaseId",
    "toReleaseId",
    "chain",
    "checkedAt",
    "checkedReferences",
    "verdict",
    "findings"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
